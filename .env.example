# Copy this file to .env and fill in real values. .env is gitignored; never commit it.
# Find these in the Neon Console: project blue-river-83534589 > Dashboard > Connect.

# Pooled connection (host contains "-pooler"). Use this for the app and serverless functions.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct connection (no "-pooler"). Use this for migrations and admin tools.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth URL (public, safe in the browser). Neon Console > Auth > Configuration.
# Used by the app for sign-in and by the API to check sign-in tokens.
VITE_NEON_AUTH_URL=https://ep-xxxxxx.neonauth.REGION.aws.neon.tech/neondb/auth
